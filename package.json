{
  "name": "vocab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "English\u2194Hungarian dictionary overlay: a hotkey-summoned chat window with definitions, IPA, examples and speech on the host.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:overlay": "VOCAB_OVERLAY_URL=http://127.0.0.1:5180 bash scripts/overlay.sh",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "overlay": "bash scripts/overlay.sh",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "icons": "bash scripts/make-icons.sh"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "express": "^5.3.0",
    "marked": "^18.2.0",
    "reka-ui": "^2.11.0",
    "tsx": "^4.20.6",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^9.2.1",
    "electron": "^44.8.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
