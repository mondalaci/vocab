{
  "name": "vocab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "English\u2194Hungarian dictionary overlay: a hotkey-summoned chat window with definitions, IPA, examples and speech on the host.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -n vite,main -c magenta,cyan \"npm:dev:client\" \"npm:dev:main\"",
    "dev:client": "vite",
    "dev:main": "esbuild electron/main.mjs --bundle --platform=node --format=esm --target=node22 --external:electron --outfile=dist-electron/main.mjs --watch",
    "dev:overlay": "VOCAB_OVERLAY_URL=http://127.0.0.1:5180 bash scripts/overlay.sh",
    "build": "npm run typecheck && vite build && npm run build:main",
    "build:main": "esbuild electron/main.mjs --bundle --platform=node --format=esm --target=node22 --external:electron --outfile=dist-electron/main.mjs",
    "start": "bash scripts/overlay.sh",
    "overlay": "bash scripts/overlay.sh",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "icons": "bash scripts/make-icons.sh"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "marked": "^18.2.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^9.2.1",
    "electron": "^44.8.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
